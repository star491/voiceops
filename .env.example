# --- LLM (any OpenAI-compatible endpoint with tool calling) ---
# OpenAI:
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
# Groq (free tier) instead:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# Gemini instead:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
JUDGE_MODEL=
# used when the main model hits its daily limit (live use only; eval.py never falls back).
# Default on Groq: openai/gpt-oss-20b,qwen/qwen3.8-27b
LLM_FALLBACK_MODELS=

# --- Gnani (STT + TTS), from app.gnani.ai/voice ---
GNANI_API_KEY=

# --- Data & retrieval ---
DATASET_DIR=./Capstone_Project_Dataset_FTTT_2026
TOP_K=6
EMBED_MODEL=BAAI/bge-small-en-v1.5
TODAY=2026-10-20

# --- Voice ---
STT_LANGUAGE=en-IN
STT_FALLBACK_LANGUAGE=hi-IN
TTS_LANGUAGE=en-IN
TTS_VOICE=Kaveri
TTS_MODEL=timbre-v2.5
TTS_MATCH_LANGUAGE=1
# optional multilingual voice for Hindi/Hinglish replies (see Gnani voice catalog)
TTS_VOICE_HI=
TTS_MODEL_HI=
